<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@android:color/white"
    app:cardElevation="8dp"
    card_view:cardCornerRadius="16dp">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivRestaurantImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintVertical_bias="0.0"
            card_view:layout_constraintBottom_toBottomOf="parent"
            card_view:layout_constraintEnd_toEndOf="parent"
            card_view:layout_constraintStart_toStartOf="parent"
            card_view:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/buttonsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="8dp"
            card_view:layout_constraintBottom_toBottomOf="@id/ivRestaurantImage"
            card_view:layout_constraintEnd_toEndOf="@id/ivRestaurantImage"
            card_view:layout_constraintStart_toStartOf="@id/ivRestaurantImage">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnDislike"
                style="@style/Widget.MaterialComponents.FloatingActionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:src="@drawable/ic_x"
                app:fabSize="normal" />


            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnRefresh"
                style="@style/Widget.MaterialComponents.FloatingActionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:src="@drawable/ic_refresh"
                app:fabSize="normal" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnLike"
                style="@style/Widget.MaterialComponents.FloatingActionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:src="@drawable/ic_heart"
                app:fabSize="normal" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/cvRestaurantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_margin="4dp"
            app:cardBackgroundColor="#76FFFFFF"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            card_view:layout_constraintBottom_toTopOf="@id/categoriesLayout"
            card_view:layout_constraintStart_toStartOf="@id/ivRestaurantImage">

            <TextView
                android:id="@+id/tvRestaurantName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="@color/textPrimary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Restaurant Name" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/DistanceLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/categoriesLayout"
            app:layout_constraintStart_toEndOf="@id/cvRestaurantName"
            app:layout_constraintTop_toTopOf="@id/cvRestaurantName">

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                app:cardBackgroundColor="#E6424141"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp"
                card_view:layout_constraintBottom_toTopOf="@id/categoriesLayout"
                card_view:layout_constraintStart_toStartOf="@id/ivRestaurantImage">

                <TextView
                    android:id="@+id/tvCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/white"
                    android:textSize="6sp"
                    android:textStyle="bold"
                    android:text="Vigo City" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                app:cardBackgroundColor="#E6424141"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp"
                card_view:layout_constraintBottom_toTopOf="@id/categoriesLayout"
                card_view:layout_constraintStart_toStartOf="@id/ivRestaurantImage">

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/white"
                    android:textSize="6sp"
                    android:textStyle="bold"
                    android:text="0Km" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/categoriesLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            card_view:layout_constraintBottom_toTopOf="@id/cvDishName"
            card_view:layout_constraintStart_toStartOf="@id/ivRestaurantImage">

            <androidx.cardview.widget.CardView
                android:id="@+id/cvCategory1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:cardBackgroundColor="#66FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tvCategory1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/textPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Category" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cvCategory2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:cardBackgroundColor="#66FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tvCategory2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/textPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Category" />

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cvCategory3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:cardBackgroundColor="#66FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tvCategory3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/textPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Category" />

            </androidx.cardview.widget.CardView>


        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/cvDishName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            app:cardBackgroundColor="#76FFFFFF"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            card_view:layout_constraintBottom_toTopOf="@id/cvDescription"
            card_view:layout_constraintStart_toStartOf="@id/ivRestaurantImage">

            <TextView
                android:id="@+id/tvDishName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Dish Name"
                android:textColor="@color/textPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>


        <androidx.cardview.widget.CardView
            android:id="@+id/cvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            app:cardBackgroundColor="#76FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toTopOf="@id/buttonsLayout"
            app:layout_constraintEnd_toEndOf="@id/ivRestaurantImage"
            app:layout_constraintStart_toStartOf="@id/ivRestaurantImage">

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="fdskjfysdhfjksdhfgdsjfsdjhkfgsdjhgjdhfgksdjhfgsdjhfgsdjkfdskjfysdhfjksdhfgdsjfsdjhkfgsdjhgjdhfgksdjhfgsdjhfgsdjkfdskjfysdhfjksdhfgdsjfsdjhkfgsdjhgjdhfgksdjhfgsdjhfgsdjk"
                android:textColor="@color/textPrimary"
                android:textSize="10sp" />
        </androidx.cardview.widget.CardView>




    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>